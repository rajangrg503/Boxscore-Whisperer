__pycache__/
*.pyc

# Finder's per-folder view settings. macOS writes these constantly, so a
# tracked one shows up as "modified" on almost every status and ends up
# in commits that have nothing to do with it. Nothing reads them.
.DS_Store

# Locally-generated watchdog diagnostic state -- changes on every run,
# not application data that should travel with the repo.
data_cache/_watchdog_status.json
logs/

# Local prediction tracker file (production uses Postgres; see engine/log_store.py)
prediction_log.csv
prediction_log.csv.lock
prediction_log.csv.tmp.*

# Regenerated by build_backtest_population.py in a couple of minutes from
# data_cache/; 65 MB of derived rows that would otherwise be cloned on
# every Streamlit Cloud deploy.
backtest_population.csv
backtest_player_games.csv
